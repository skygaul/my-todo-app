# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env는 Docker Compose와 Next.js가 함께 읽습니다. 절대 Git에 커밋하지 마세요.

# --- Docker PostgreSQL 초기 설정 (컨테이너 최초 생성 시에만 적용) ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=
POSTGRES_DB=my_todo

# --- Next.js 서버가 DB에 접속할 때 사용 ---
# 형식: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB이름>
# Supabase로 이전할 때는 이 값만 Supabase 접속 문자열로 바꾸면 됩니다.
DATABASE_URL=postgresql://todo:<비밀번호>@localhost:5432/my_todo
